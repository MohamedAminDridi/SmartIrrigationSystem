# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB (only database needed) ───────────────
# Local:
MONGO_URI=mongodb://localhost:27017/smart_irrigation
# MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/smart_irrigation?retryWrites=true&w=majority

# ── Redis (optional — for caching & job queues) ──
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── MQTT ─────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=irrigation-backend

# ── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Firebase (push notifications) ────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Twilio (SMS / WhatsApp) ───────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# ── Admin seed ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@irrigation.io
SEED_ADMIN_PASSWORD=Admin@1234
